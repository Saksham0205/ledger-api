PORT=3000
# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ledger
# Set to true for hosted Postgres such as Supabase
DATABASE_SSL=false
# Used only by `npm run test:e2e` (database is created by docker-compose init)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/ledger_test
